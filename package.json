{
  "name": "sys32roulette",
  "version": "1.0.0",
  "description": "System 32 Roulette — competitive minigame battler. Lose and face system annihilation. (jk)",
  "main": "main.js",
  "homepage": "https://sys32.hackatoa.com",
  "author": {
    "name": "Hackatoa",
    "email": "jacobprestonharris@gmail.com",
    "url": "https://hackatoa.com"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --linux --win"
  },
  "build": {
    "appId": "com.hackatoa.sys32roulette",
    "productName": "System 32 Roulette",
    "copyright": "© 2025 Hackatoa",
    "files": [
      "main.js",
      "preload.js",
      "lose-action.js"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Hackatoan",
        "repo": "sys32roulette"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "System 32 Roulette",
      "artifactName": "Sys32Roulette-Setup-x64.exe"
    },
    "portable": {
      "artifactName": "Sys32Roulette-Portable-x64.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "description": "Competitive minigame battler with fake system destruction",
      "executableArgs": ["--no-sandbox"],
      "artifactName": "Sys32Roulette-x64.${ext}"
    },
    "deb": {
      "packageCategory": "games"
    }
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  },
  "engines": {
    "node": ">=18"
  }
}
