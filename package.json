{
  "name": "sys32roulette",
  "version": "1.0.0",
  "description": "System 32 Roulette \u2014 competitive minigame battler. Lose and face system annihilation. (jk)",
  "main": "main.js",
  "homepage": "https://sys32.hackatoa.com",
  "author": {
    "name": "Hackatoa",
    "email": "jacobprestonharris@gmail.com",
    "url": "https://hackatoa.com"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --linux --win --mac"
  },
  "build": {
    "appId": "com.hackatoa.sys32roulette",
    "productName": "System 32 Roulette",
    "copyright": "\u00a9 2025 Hackatoa",
    "files": [
      "main.js",
      "preload.js",
      "lose-action.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "description": "Competitive 1v1 minigame battler. 15 minigames, 5 random rounds per match. Loser faces system deletion.",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "System 32 Roulette"
    },
    "deb": {
      "packageCategory": "games"
    }
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  },
  "engines": {
    "node": ">=18"
  }
}
